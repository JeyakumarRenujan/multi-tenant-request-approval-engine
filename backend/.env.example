# Server Configuration
PORT=5000

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workflow_engine?schema=public"

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="your_jwt_access_secret_here_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here_min_32_chars"

